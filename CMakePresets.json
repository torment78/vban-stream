{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "Windows x64 \u2014 Visual Studio 2026",
      "description": "MSVC v145, Windows SDK 10.0.26100.0, native OBS VBAN plugin",
      "binaryDir": "${sourceDir}/build_x64",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64,version=10.0.26100.0",
      "toolset": "v145",
      "cacheVariables": {
        "ENABLE_FRONTEND_API": true,
        "ENABLE_QT": true,
        "BUILD_TESTING": true,
        "CMAKE_COMPILE_WARNING_AS_ERROR": true
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "macos-universal",
      "displayName": "macOS - Apple Silicon and Intel",
      "binaryDir": "${sourceDir}/build_macos",
      "generator": "Xcode",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0",
        "ENABLE_FRONTEND_API": true,
        "ENABLE_QT": true,
        "BUILD_TESTING": true,
        "CMAKE_COMPILE_WARNING_AS_ERROR": false
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64",
      "configurePreset": "windows-x64",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "macos-release",
      "configurePreset": "macos-universal",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-x64",
      "configurePreset": "windows-x64",
      "configuration": "RelWithDebInfo",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-release",
      "configurePreset": "macos-universal",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
